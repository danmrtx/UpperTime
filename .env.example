# ==========================================
# VARIÁVEIS DE AMBIENTE - UPPERTIME NA VERCEL
# ==========================================
# Adicione estas variáveis nas configurações do projeto na Vercel:
# Project Settings -> Environment Variables

# URL do seu projeto no Supabase (Ex: https://xyzcompany.supabase.co)
# Obtenha em: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Anônima Pública (anon / public key) do Supabase
# Obtenha em: Supabase Dashboard -> Project Settings -> API -> Project API keys (anon public)
SUPABASE_ANON_KEY=sua-chave-anonima-publica-aqui

# Chave customizada de cabeçalho da API (opcional, padrão: 3009)
CHAVE_URL=3009
